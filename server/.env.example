# Server Environment Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_string

# Optional: Restrict CORS to a specific client domain in split deployments (e.g. https://your-app.vercel.app)
# If left empty, allows all origins
CLIENT_URL=

# Optional: PostgreSQL Connection string (if using external Postgres database like Supabase/Neon/Render)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
